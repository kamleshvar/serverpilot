SERVERPILOT_API_URL=https://panel.example.com
# Prefer the single-use token generated by the admin server installer.
AGENT_ENROLLMENT_TOKEN=replace-with-the-generated-enrollment-token
# Legacy shared bootstrap token; leave empty when using enrollment tokens.
AGENT_BOOTSTRAP_TOKEN=
AGENT_UID=agent-primary-app-server
AGENT_NAME=primary-app-server
AGENT_HOSTNAME=app-1.example.com
AGENT_WORK_DIR=/var/lib/serverpilot
AGENT_STATE_DIR=/var/lib/serverpilot/agent
AGENT_PROXY_DIR=/etc/nginx/conf.d/serverpilot
AGENT_PROXY_ENABLED=true
AGENT_NGINX_SUDO=true
AGENT_NGINX_BIN=/usr/sbin/nginx
AGENT_DOCKER_NETWORK=serverpilot-apps
AGENT_HEARTBEAT_INTERVAL=30
AGENT_POLL_INTERVAL=5
AGENT_LOG_LEVEL=INFO
